// Rafay engine fork — build, conformance-gate, publish.
//
// Follows the house pattern in RafaySystems/kubeless (inline helpers, buildx +
// S3 cache, docker.withRegistry, slack post) with three differences that come
// from this being a *fork of someone else's release* rather than our own source:
//
//  1. **Tags only.** Branch builds are refused outright, not merely
//     discouraged. The version scheme is v<upstream>-rafay.<n> and its whole
//     purpose is that the upstream release is named in the artifact; an image
//     built from a moving branch cannot answer "which upstream is this?", which
//     is the one question the scheme exists to answer.
//  2. **Conformance gates publication.** A build that has not proved tenant
//     isolation per backend does not reach the registry — an image that exists
//     is an image someone will run.
//  3. It **records what it proved** on the image, so "which build is safe under
//     multi-tenancy?" is answerable from the artifact rather than from memory.
//
// See kubeless-me/docs/model-engine-fork-release.md.

def buildAndPush(Map config = [:]) {
    def registryUrl        = config.get('registryUrl',        'https://registry.dev.rafay-edge.net')
    def registryCredential = config.get('registryCredential', 'rcloud_user_registry.stage.rafay.cloud')
    def registry           = config.get('registry',           'registry.dev.rafay-edge.net')
    def repository         = config.get('repository',         'rafay')
    def imageName          = config.get('imageName',          '')
    def tag                = config.get('tag',                '')
    def dockerfile         = config.get('dockerfile',         './docker/Dockerfile')
    def contextPath        = config.get('contextPath',        '.')
    def platform           = config.get('platform',           'linux/amd64')
    def push               = config.get('push',               false)
    def labels             = config.get('labels',             [:])
    def buildArgs          = config.get('buildArgs',          [:])

    def s3CacheBucket = config.get('s3CacheBucket', 'amzn-s3-build-onprem-cache')
    def s3CacheRegion = config.get('s3CacheRegion', 'us-west-2')
    def s3CachePrefix = config.get('s3CachePrefix', "buildcache/${imageName}/")

    script {
        docker.withRegistry(registryUrl, registryCredential) {
            sh("docker buildx create --name connector --use 2>/dev/null || docker buildx use connector")
            sh("docker buildx inspect --bootstrap connector")

            def s3Base      = "type=s3,region=${s3CacheRegion},bucket=${s3CacheBucket},prefix=${s3CachePrefix}"
            // ignore-error on export, matching kubeless: a cache write failure
            // must not fail a build whose image already pushed.
            def cacheArgs   = "--cache-from=${s3Base} --cache-to=${s3Base},mode=max,ignore-error=true"
            def labelArgs   = labels.collect { k, v -> "--label ${k}=\"${v}\"" }.join(' ')
            def buildArgArgs = buildArgs.collect { k, v -> "--build-arg ${k}=\"${v}\"" }.join(' ')

            // Load locally when not publishing, so conformance runs against the
            // exact image that would ship rather than a rebuild of it.
            def outputArg = push ? "type=image,push=true" : "type=docker"

            sh("""
                docker buildx build \\
                    --platform ${platform} \\
                    --provenance=false \\
                    --pull \\
                    ${cacheArgs} \\
                    ${buildArgArgs} \\
                    ${labelArgs} \\
                    -f ${dockerfile} \\
                    -t ${registry}/${repository}/${imageName}:${tag} \\
                    --output ${outputArg} \\
                    ${contextPath}
            """)
        }
    }
}

// Build args, in one place: the conformance-gated build and the published build
// must be byte-identical, and the surest way to guarantee that is for them to
// read the same function rather than two argument lists someone edits singly.
def rafayBuildArgs() {
    def args = [
        // **The one that decides whether this is our engine at all.**
        // docker/Dockerfile defaults to BRANCH_TYPE=remote, which git-clones
        // sgl-project/sglang from GitHub. Left unset, the build either fails on
        // the SGL_VERSION guard or -- worse, if someone supplies SGL_VERSION to
        // get past it -- succeeds and ships UPSTREAM source carrying our labels
        // and our tag. 'local' is what makes the image contain the fork.
        'BRANCH_TYPE'                  : 'local',

        // Provenance the Dockerfile already accepts and bakes into ENV, so it
        // is readable from a running container and not only from image
        // metadata — which is where you want it when debugging a live pod.
        'SGLANG_BUILD_COMMIT'          : env.GIT_SHA,
        'SGLANG_BUILD_URL'             : "${env.BUILD_URL ?: ''}",
        'SGLANG_IMAGE_TAG'             : "${env.registry}/${env.repository}/${env.imageName}:${env.RAFAY_TAG}",
        'INSTALL_FLASHINFER_JIT_CACHE' : params.INSTALL_FLASHINFER_JIT_CACHE?.trim() ?: '1',
    ]
    if (params.MOONCAKE_VERSION?.trim()) { args['MOONCAKE_VERSION'] = params.MOONCAKE_VERSION.trim() }
    if (params.CUDA_VERSION?.trim())     { args['CUDA_VERSION']     = params.CUDA_VERSION.trim() }
    return args
}

pipeline {
    environment {
        registryCredential = 'rcloud_user_registry.stage.rafay.cloud'
        registryUrl        = 'https://registry.dev.rafay-edge.net'
        registry           = 'registry.dev.rafay-edge.net'
        repository         = 'rafay'
        imageName          = 'gmaas-sglang'

        S3_BUILD_CACHE_BUCKET = "${env.S3_BUILD_CACHE_BUCKET ?: 'amzn-s3-build-onprem-cache'}"
        S3_BUILD_CACHE_REGION = "${env.S3_BUILD_CACHE_REGION ?: 'us-west-2'}"
    }

    agent {
        // node-1 rather than ec2-fleet: the fleet label resolved to
        // ec2-arm-worker-fleet, and these are amd64 CUDA builds. The
        // preflight stage still verifies rather than trusting this.
        label params.AGENT_LABEL?.trim() ? params.AGENT_LABEL.trim() : 'node-1'
    }

    parameters {
        string(
            name: 'RAFAY_TAG',
            defaultValue: '',
            description: 'The Rafay tag to build, e.g. v0.5.16-rafay.1. Ignored when the job is a multibranch tag build (TAG_NAME wins). Required otherwise — branch builds are refused.'
        )
        string(name: 'AGENT_LABEL',     defaultValue: '', description: 'Optional Jenkins agent label override.')
        string(
            name: 'BUILD_PLATFORM',
            defaultValue: 'linux/amd64',
            description: 'Target OCI platform. amd64 only — the EKS GPU fleet is x86, and docker/Dockerfile is the CUDA build (arm64 has its own Dockerfile).'
        )
        string(
            name: 'INSTALL_FLASHINFER_JIT_CACHE',
            defaultValue: '1',
            description: 'Install the prebuilt FlashInfer JIT cache wheel. 1 moves JIT compilation from first-request to build time — the Dockerfile default of 0 would make the first inference on every cold pod pay for it.'
        )
        string(
            name: 'MOONCAKE_WHEEL_IMAGE',
            defaultValue: '',
            description: 'Wheel image from the Mooncake fork pipeline, e.g. registry/rafay/gmaas-mooncake-wheel:v0.3.12.post1-rafay.1. Blank skips the bundle overlay and publishes a base image whose Mooncake is UPSTREAM.'
        )
        string(
            name: 'LMCACHE_WHEEL_IMAGE',
            defaultValue: '',
            description: 'Wheel image from the LMCache fork pipeline. Blank skips the bundle overlay.'
        )
        string(name: 'BUNDLE_VERSION', defaultValue: '', description: 'Bundle this build belongs to, e.g. 2026.08.1. Required when the wheel images are set.')
        string(
            name: 'MOONCAKE_VERSION',
            defaultValue: '',
            description: 'Mooncake version compiled into the image. Leave blank to take the Dockerfile default; set from the bundle once the Mooncake fork carries patches, or the image ships an unpatched transfer engine while claiming a patched bundle.'
        )
        string(name: 'LMCACHE_VERSION', defaultValue: '', description: 'Expected LMCache version in the bundled image. Verified after install.')
        string(name: 'CUDA_VERSION',    defaultValue: '', description: 'Optional CUDA override. Blank uses the Dockerfile default.')
        string(
            name: 'CONFORMANCE_AGENT',
            defaultValue: 'gpu-node',
            description: 'Agent for the Tier 3a conformance suite. Needs a GPU and the storage backends.'
        )
        booleanParam(
            name: 'ALLOW_UNPROVEN_PUBLISH',
            defaultValue: false,
            // Exists because there will be a legitimate reason one day -- a
            // registry-only rebuild, a platform port. It is a parameter rather
            // than a code path so that using it is a recorded decision with a
            // name against it, and so the audit question "was this image
            // proved?" has an answer either way.
            description: 'DANGEROUS. Publish even if conformance fails or is skipped. The image is labelled unproven and MUST NOT be used for multi-tenant serving.'
        )
    }

    options {
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    stages {
        stage('Resolve tag') {
            steps {
                script {
                    // In a multibranch job Jenkins sets TAG_NAME for a tag build
                    // and leaves it unset for a branch build. Preferring it, and
                    // refusing when neither source yields a tag, is what makes
                    // "tags only" a property of the pipeline rather than of the
                    // job configuration someone may later change.
                    env.RAFAY_TAG = (env.TAG_NAME?.trim() ?: params.RAFAY_TAG?.trim()) ?: ''

                    if (!env.RAFAY_TAG) {
                        error(
                            "Refusing to build: no tag. This pipeline builds named releases only.\n" +
                            "Branch '${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'unknown'}' cannot produce a release image — " +
                            "see kubeless-me/docs/model-engine-fork-release.md."
                        )
                    }

                    // Fail on a tag that does not match the scheme rather than
                    // producing an image whose name implies an upstream release
                    // it was not built from.
                    if (!(env.RAFAY_TAG ==~ /^v.+-rafay\.\d+$/)) {
                        error("RAFAY_TAG '${env.RAFAY_TAG}' does not match v<upstream>-rafay.<n>.")
                    }

                    sh "git fetch --tags --force origin"
                    sh "git checkout -q ${env.RAFAY_TAG}"

                    env.UPSTREAM_VERSION = env.RAFAY_TAG.replaceFirst(/-rafay\.\d+$/, '')
                    env.GIT_SHA          = sh(script: "git rev-parse HEAD", returnStdout: true).trim()

                    // The delta is the fork's liability, so surface its size on
                    // every build. A number that climbs quietly is the failure
                    // mode this fork is most likely to have.
                    // Best-effort: the fork may not carry upstream's tags, and a
                    // release must not fail because a diagnostic could not be
                    // computed. Reported as 'unknown' rather than silently 0 —
                    // zero would read as "no Rafay changes", which is a claim,
                    // not an absence of information.
                    env.PATCH_COUNT = sh(
                        script: """
                            if git rev-parse -q --verify '${env.UPSTREAM_VERSION}^{commit}' >/dev/null; then
                                git rev-list --count ${env.UPSTREAM_VERSION}..HEAD
                            else
                                echo unknown
                            fi
                        """,
                        returnStdout: true
                    ).trim()

                    if (env.PATCH_COUNT == 'unknown') {
                        echo "NOTE: upstream tag ${env.UPSTREAM_VERSION} is not present in origin, so the " +
                             "Rafay delta cannot be measured. Push upstream tags to the fork " +
                             "(git push origin ${env.UPSTREAM_VERSION}) to restore it — the workflow also " +
                             "needs them to cut release branches from a fresh clone."
                    }

                    echo "Building ${env.RAFAY_TAG} — upstream ${env.UPSTREAM_VERSION}, ${env.PATCH_COUNT} Rafay commits"
                }
            }
        }

        stage('Preflight: agent matches target platform') {
            steps {
                script {
                    // The first run landed an amd64 build on ec2-arm-worker-fleet.
                    // Under qemu that is either very slow or fails deep inside a
                    // CUDA/C++ compile, twenty minutes in, with an error that
                    // does not mention architecture. Fail here instead, in two
                    // seconds, saying exactly what is wrong.
                    def agentArch = sh(script: "uname -m", returnStdout: true).trim()
                    def want      = (params.BUILD_PLATFORM?.trim() ?: 'linux/amd64').tokenize('/').last()
                    def agentIs   = (agentArch in ['x86_64', 'amd64']) ? 'amd64' : 'arm64'

                    if (agentIs != want) {
                        error(
                            "Agent is ${agentArch} (${agentIs}) but BUILD_PLATFORM targets ${want}.\n" +
                            "Cross-building would run under qemu emulation — unusably slow for a CUDA/C++ wheel.\n" +
                            "Set AGENT_LABEL to an ${want} fleet, or change BUILD_PLATFORM to match the agent."
                        )
                    }
                    echo "Agent ${agentArch} matches target ${want}"
                }
            }
        }

        stage('Unit + scoping regression') {
            steps {
                // Deliberately no GPU: these guard a few lines in functions
                // upstream rarely touches, which is exactly what a merge drops
                // silently. They must be cheap enough to run on every build.
                sh "python3 -m pytest test/srt/rafay -q"
            }
        }

        stage('Build image') {
            steps {
                script {
                    buildAndPush(
                        registryUrl        : env.registryUrl,
                        registryCredential : env.registryCredential,
                        registry           : env.registry,
                        repository         : env.repository,
                        imageName          : env.imageName,
                        tag                : env.RAFAY_TAG,
                        dockerfile         : './docker/Dockerfile',
                        contextPath        : '.',
                        platform           : params.BUILD_PLATFORM?.trim() ?: 'linux/amd64',
                        push               : false,
                        s3CacheBucket      : env.S3_BUILD_CACHE_BUCKET,
                        s3CacheRegion      : env.S3_BUILD_CACHE_REGION,
                        buildArgs          : rafayBuildArgs(),
                        labels             : [
                            'io.rafay.upstream.version' : env.UPSTREAM_VERSION,
                            'io.rafay.upstream.commit'  : env.GIT_SHA,
                            'io.rafay.patch.count'      : env.PATCH_COUNT,
                            'io.rafay.tag'              : env.RAFAY_TAG,
                        ]
                    )
                }
            }
        }

        stage('Verify image is the fork') {
            steps {
                script {
                    // Asserting the build arg was set proves only that we asked.
                    // This proves the source arrived: the scoping module exists
                    // in the image, and the commit baked into ENV is the tag we
                    // built. An image that fails here is upstream wearing our
                    // label, which is the single most misleading artifact this
                    // pipeline could produce.
                    def img = "${env.registry}/${env.repository}/${env.imageName}:${env.RAFAY_TAG}"
                    sh """
                        docker run --rm --entrypoint python3 ${img} -c "
import sys, os
from sglang.srt.mem_cache.tenant_scope import tenant_scope_seed
assert tenant_scope_seed('acme') != tenant_scope_seed('globex'), 'scoping module present but not functioning'
got = os.environ.get('SGLANG_BUILD_COMMIT', '')
assert got == '${env.GIT_SHA}', f'image built from {got}, expected ${env.GIT_SHA}'
print('image verified: fork source, commit', got)
"
                    """
                }
            }
        }

        stage('Bundle overlay') {
            when {
                expression { params.MOONCAKE_WHEEL_IMAGE?.trim() && params.LMCACHE_WHEEL_IMAGE?.trim() }
            }
            steps {
                script {
                    if (!params.BUNDLE_VERSION?.trim()) {
                        error("BUNDLE_VERSION is required when wheel images are supplied — an image carrying forked components but no bundle name cannot be pinned by a ServingRuntime.")
                    }
                    def base = "${env.registry}/${env.repository}/${env.imageName}:${env.RAFAY_TAG}"

                    // Overwrites the base tag deliberately: the artefact that
                    // ships is the bundle, and leaving a same-named image around
                    // that lacks the forked components is how the wrong one gets
                    // deployed.
                    buildAndPush(
                        registryUrl        : env.registryUrl,
                        registryCredential : env.registryCredential,
                        registry           : env.registry,
                        repository         : env.repository,
                        imageName          : env.imageName,
                        tag                : env.RAFAY_TAG,
                        dockerfile         : './docker/Dockerfile.rafay',
                        contextPath        : '.',
                        platform           : params.BUILD_PLATFORM?.trim() ?: 'linux/amd64',
                        push               : false,
                        s3CacheBucket      : env.S3_BUILD_CACHE_BUCKET,
                        s3CacheRegion      : env.S3_BUILD_CACHE_REGION,
                        buildArgs          : [
                            'BASE_IMAGE'           : base,
                            'MOONCAKE_WHEEL_IMAGE' : params.MOONCAKE_WHEEL_IMAGE.trim(),
                            'LMCACHE_WHEEL_IMAGE'  : params.LMCACHE_WHEEL_IMAGE.trim(),
                            'MOONCAKE_VERSION'     : params.MOONCAKE_VERSION?.trim() ?: '',
                            'LMCACHE_VERSION'      : params.LMCACHE_VERSION?.trim() ?: '',
                            'BUNDLE_VERSION'       : params.BUNDLE_VERSION.trim(),
                        ],
                        labels             : ['io.rafay.bundle': params.BUNDLE_VERSION.trim()]
                    )
                    env.BUNDLED = 'true'
                }
            }
        }

        stage('Tier 3a conformance') {
            agent { label params.CONFORMANCE_AGENT }
            steps {
                script {
                    // Two tenants store byte-identical content; neither may
                    // address the other's entries, at every tier, through every
                    // configured backend. Per backend, because the finding that
                    // motivated this was one backend keying unlike the rest.
                    def rc = sh(
                        returnStatus: true,
                        script: """
                            python3 -m pytest test/srt/rafay/conformance \\
                                --image ${env.registry}/${env.repository}/${env.imageName}:${env.RAFAY_TAG} \\
                                --junitxml=conformance.xml \\
                                --json-report --json-report-file=conformance.json \\
                                -q
                        """
                    )
                    env.CONFORMANCE_RESULT = (rc == 0) ? 'pass' : 'fail'

                    // An unrecognized backend is a FAILING backend, not a
                    // skipped one. Skipping quietly is how LMCache's raw-token
                    // lookup went unnoticed in the first place.
                    env.CONFORMANCE_PROVIDERS = sh(
                        returnStdout: true,
                        script: "python3 scripts/rafay/conformance_providers.py conformance.json || echo ''"
                    ).trim()

                    echo "Conformance: ${env.CONFORMANCE_RESULT}; providers proved: ${env.CONFORMANCE_PROVIDERS ?: '(none)'}"
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'conformance.xml'
                    archiveArtifacts artifacts: 'conformance.json', allowEmptyArchive: true
                }
            }
        }

        stage('Publish') {
            steps {
                script {
                    def proved = (env.CONFORMANCE_RESULT == 'pass')

                    if (!proved && !params.ALLOW_UNPROVEN_PUBLISH) {
                        error("Conformance ${env.CONFORMANCE_RESULT} — not publishing ${env.RAFAY_TAG}. An image that exists is an image someone will run.")
                    }
                    if (!proved) {
                        echo "WARNING: publishing UNPROVEN ${env.RAFAY_TAG} under ALLOW_UNPROVEN_PUBLISH."
                    }

                    buildAndPush(
                        registryUrl        : env.registryUrl,
                        registryCredential : env.registryCredential,
                        registry           : env.registry,
                        repository         : env.repository,
                        imageName          : env.imageName,
                        tag                : env.RAFAY_TAG,
                        dockerfile         : './docker/Dockerfile',
                        contextPath        : '.',
                        platform           : params.BUILD_PLATFORM?.trim() ?: 'linux/amd64',
                        push               : true,
                        s3CacheBucket      : env.S3_BUILD_CACHE_BUCKET,
                        s3CacheRegion      : env.S3_BUILD_CACHE_REGION,
                        buildArgs          : rafayBuildArgs(),
                        labels             : [
                            'io.rafay.upstream.version'         : env.UPSTREAM_VERSION,
                            'io.rafay.upstream.commit'          : env.GIT_SHA,
                            'io.rafay.patch.count'              : env.PATCH_COUNT,
                            'io.rafay.tag'                      : env.RAFAY_TAG,
                            'io.rafay.conformance.tier3a'       : proved ? 'pass' : 'unproven',
                            // The allow-list ValidateRuntimeTenantScoping
                            // enforces at admission. Empty means no provider is
                            // permitted for multi-tenant serving, which is the
                            // honest value until a suite proves one.
                            'io.rafay.conformance.providers'    : env.CONFORMANCE_PROVIDERS ?: '',
                        ]
                    )
                }
            }
        }

        stage('Attest') {
            when { expression { env.CONFORMANCE_RESULT == 'pass' } }
            steps {
                script {
                    // Labels are convenient and forgeable. The label is for
                    // humans; the attestation is what admission may rely on.
                    withCredentials([file(credentialsId: 'cosign-key', variable: 'COSIGN_KEY')]) {
                        sh """
                            cosign attest --yes --key \$COSIGN_KEY \\
                                --type https://rafay.co/attestations/kv-tenant-isolation/v1 \\
                                --predicate conformance.json \\
                                ${env.registry}/${env.repository}/${env.imageName}:${env.RAFAY_TAG}
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            slackSend channel: "#build", color: 'good',
                message: "${env.imageName}:${env.RAFAY_TAG} published — conformance ${env.CONFORMANCE_RESULT}, ${env.PATCH_COUNT} Rafay commits on ${env.UPSTREAM_VERSION}."
        }
        failure {
            slackSend channel: "#build", color: 'RED',
                message: "Attention ${env.JOB_NAME} ${env.BUILD_NUMBER} failed for ${params.RAFAY_TAG}."
        }
        always {
            deleteDir()
            dir("${workspace}@tmp") { deleteDir() }
            dir("${workspace}@script") { deleteDir() }
        }
    }
}

// ── Job configuration — tags only ────────────────────────────────────────────
//
// The guard above refuses a branch build at runtime, but a job that never
// *starts* on a branch is better than one that starts and fails. Configure the
// multibranch job so the two agree:
//
//   Branch Sources → Git → Behaviours:
//     - Discover tags                                    (enable)
//     - Discover branches                                (REMOVE)
//     - Filter by name (with regular expression):  ^v.+-rafay\.\d+$
//
// With branch discovery removed, only tags matching the release scheme are ever
// indexed. The runtime guard then covers the manual-trigger path, where someone
// can still launch the job by hand.
//
// Webhook: a tag push to origin triggers indexing, which starts the build. No
// separate trigger is needed, and none should be added — a cron or SCM-poll
// trigger would reintroduce branch builds by the back door.

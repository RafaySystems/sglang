# Rafay engine bundle — overlay that copies wheels from per-fork wheel images.
#
# Builds the image that ships: our SGLang, our Mooncake, our LMCache.
#
# ## Why COPY --from wheel images rather than pip install
#
# The forks are not published to any pip index and will not be. So the wheel has
# to come from somewhere we build. Two ways to do that, and this takes the
# second:
#
#   a) `git clone` the forks and build them here. Self-contained, and rebuilds
#      two CUDA/C++ projects on every SGLang build — minutes of compute for
#      source that did not change.
#   b) Each fork's own pipeline produces a **wheel image**, tagged with that
#      fork's Rafay tag, and this file copies the artefact out.
#
# (b) also makes the bundle honest: each component is built, versioned and
# tagged by its own pipeline, and the bundle is the act of naming three specific
# artefacts. With (a) the "Mooncake version" would be whatever a git ref
# resolved to at build time, which is exactly the ambiguity the tagging scheme
# exists to remove.
#
# ## Why this FROMs the upstream-built base rather than copying docker/Dockerfile
#
# `docker/Dockerfile` is ~950 lines and churns with every CUDA and kernel bump.
# A copied Dockerfile does not conflict — **it silently rots**. There is no merge
# to resolve and no signal of falling behind, only divergence discovered when
# something fails months later. The base is built from that file *in our fork*
# (with BRANCH_TYPE=local, so it carries our SGLang source), and this file adds
# only what pip cannot be pointed at from there.
#
# ## Contract for a wheel image
#
# A wheel image places its artefacts in **/wheels** and contains nothing else of
# consequence. `scratch` is enough. Building it is the job of
# `Jenkinsfile.rafay` in each fork.

ARG BASE_IMAGE
ARG MOONCAKE_WHEEL_IMAGE
ARG LMCACHE_WHEEL_IMAGE

FROM ${MOONCAKE_WHEEL_IMAGE} AS mooncake_wheels
FROM ${LMCACHE_WHEEL_IMAGE}  AS lmcache_wheels

FROM ${BASE_IMAGE}

ARG MOONCAKE_VERSION
ARG LMCACHE_VERSION
ARG BUNDLE_VERSION=unknown

COPY --from=mooncake_wheels /wheels /tmp/rafay-wheels/mooncake
COPY --from=lmcache_wheels  /wheels /tmp/rafay-wheels/lmcache

# --force-reinstall: the base already installed upstream mooncake-transfer-engine
#   from PyPI, and pip may consider the requirement satisfied by version alone.
# --no-deps: a fork's dependency metadata must not quietly pull a different
#   transitive set than the base was built and tested against.
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eu; \
    ls /tmp/rafay-wheels/mooncake/*.whl >/dev/null 2>&1 || { echo "no Mooncake wheel in ${MOONCAKE_WHEEL_IMAGE}"; exit 1; }; \
    ls /tmp/rafay-wheels/lmcache/*.whl  >/dev/null 2>&1 || { echo "no LMCache wheel in ${LMCACHE_WHEEL_IMAGE}";  exit 1; }; \
    # A wheel image holds every Python version its matrix built -- Mooncake's
    # covers 3.10 through 3.13. Installing the glob hands pip all of them and
    # it refuses the first one that does not match this interpreter:
    # "mooncake_transfer_engine_cuda13-...-cp310-cp310-...whl is not a
    # supported wheel on this platform". The wheel is not wrong; the selection
    # was. Let pip choose from the directory instead, by name.
    PYTAG="cp$(python3 -c 'import sys; print(f"{sys.version_info.major}{sys.version_info.minor}")')"; \
    echo "selecting wheels for ${PYTAG}"; \
    select_wheel() { \
        ls "$1"/*"${PYTAG}"*.whl 2>/dev/null | head -1 \
          || ls "$1"/*-py3-none-any.whl 2>/dev/null | head -1 \
          || ls "$1"/*abi3*.whl 2>/dev/null | head -1; \
    }; \
    MOONCAKE_WHL="$(select_wheel /tmp/rafay-wheels/mooncake)"; \
    LMCACHE_WHL="$(select_wheel /tmp/rafay-wheels/lmcache)"; \
    [ -n "$MOONCAKE_WHL" ] || { echo "no Mooncake wheel for ${PYTAG} in ${MOONCAKE_WHEEL_IMAGE}"; ls /tmp/rafay-wheels/mooncake; exit 1; }; \
    [ -n "$LMCACHE_WHL" ]  || { echo "no LMCache wheel for ${PYTAG} in ${LMCACHE_WHEEL_IMAGE}";  ls /tmp/rafay-wheels/lmcache;  exit 1; }; \
    echo "installing $MOONCAKE_WHL and $LMCACHE_WHL"; \
    python3 -m pip install --force-reinstall --no-deps "$MOONCAKE_WHL" "$LMCACHE_WHL"; \
    rm -rf /tmp/rafay-wheels

# Prove the overlay took, and that the wheels actually load.
#
# **This is where the torch ABI pairing is checked.** The wheel pipelines build
# independently, against a TORCH_VERSION they are told to match. Nothing forces
# that to be true — so import the modules here, where both halves are present.
# A wheel built against the wrong torch fails at import, and it fails in CI
# naming both versions rather than in a serving pod at 3am.
#
# A build reaching this point with upstream packages still installed, or with
# wheels that cannot load, must not become an image: that artefact would carry
# our tag, our labels and our conformance claim over code that does not work.
RUN python3 - <<'PY'
import importlib.metadata as md
import os, sys

# Mooncake publishes a distribution per CUDA major -- the CUDA 13 build is
# `mooncake-transfer-engine-cuda13`, not `mooncake-transfer-engine`. Match on
# prefix so a CUDA bump does not fail this check for the wrong reason: the
# first run reported "mooncake-transfer-engine: not installed" about a package
# that was installed and imported perfectly well.
def find_installed(prefix):
    for dist in md.distributions():
        name = (dist.metadata["Name"] or "").lower().replace("_", "-")
        if name == prefix or name.startswith(prefix + "-"):
            return name, dist.version
    return None, None

expected = {
    "mooncake-transfer-engine": os.environ.get("EXPECT_MOONCAKE", ""),
    "lmcache": os.environ.get("EXPECT_LMCACHE", ""),
}
problems = []
for pkg, want in expected.items():
    name, got = find_installed(pkg)
    if got is None:
        problems.append(f"{pkg}: not installed (no distribution matching '{pkg}*')")
        continue
    pkg = name
    # Substring rather than equality: a wheel built from a Rafay tag may carry a
    # local version segment (e.g. 0.3.12.post1+rafay.1) that does not match the
    # tag string byte for byte. What must hold is that it is *ours*.
    if want and want not in got:
        problems.append(f"{pkg}: installed {got}, expected to contain {want}")

# Import, do not merely check metadata. A version string proves the wheel was
# installed; only an import proves it links against this image's torch.
import torch
for mod in ("mooncake", "lmcache"):
    try:
        __import__(mod)
    except Exception as exc:
        problems.append(
            f"{mod}: installed but will not import against torch {torch.__version__} "
            f"(cuda {torch.version.cuda}) -- {type(exc).__name__}: {exc}"
        )

if problems:
    print("Rafay overlay verification FAILED:", *problems, sep="\n  ")
    print("\nIf this is an ABI failure, rebuild the wheel with TORCH_VERSION/CUDA_TAG "
          "matching this image.")
    sys.exit(1)
print("Rafay overlay verified against torch", torch.__version__,
      "| cuda", torch.version.cuda, "|",
      {n: v for n, v in (find_installed(k) for k in expected) if n})
PY

LABEL io.rafay.bundle="${BUNDLE_VERSION}" \
      io.rafay.component.mooncake="${MOONCAKE_VERSION}" \
      io.rafay.component.lmcache="${LMCACHE_VERSION}"
